# 三个模型家族,三个 key。sealed 判官必须与生成不同家族。
# 生成家族(部署级中档即可,如 qwen-plus / qwen-max)
GEN_API_KEY=
GEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# dev 判官家族(可与生成同家族;LLM-as-a-Verifier 需要 logprobs 支持,见 contract/judges.yaml)
JUDGE_DEV_API_KEY=
JUDGE_DEV_API_BASE=
# sealed 判官家族(必须跨家族,如 glm / deepseek / kimi)
JUDGE_SEALED_API_KEY=
JUDGE_SEALED_API_BASE=
